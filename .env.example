# TT-006: copie este archivo como .env (cp .env.example .env) y cambie la contraseña.
# El archivo .env está en .gitignore: nunca se sube al repositorio.
# Contraseña de SQL Server: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
# No use ; $ # ni comillas, porque rompen la cadena de conexión.
VACANJEF_SA_PASSWORD=CambieEsta.Clave2026

# HU-015: primer administrador. Se crea al iniciar solo si no existe ninguno.
# La contraseña cumple las mismas reglas: 8+ caracteres con mayúscula, minúscula, número y símbolo.
VACANJEF_ADMIN_CORREO=admin@vacanjef.local
VACANJEF_ADMIN_CONTRASENA=CambieEsta.Admin2026
