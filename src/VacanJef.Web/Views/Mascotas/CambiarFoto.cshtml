@model VacanJef.Web.Models.Mascotas.CambiarFotoViewModel
@{
    ViewData["Title"] = "Foto de la mascota";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Foto de @Model.Nombre</h1>

        @if (Model.TieneFoto)
        {
            <img src="@Url.Action("Foto", new { id = Model.Id })" alt="Foto actual de @Model.Nombre"
                 width="320" class="img-fluid rounded border mb-3" />
        }
        else
        {
            <p class="text-muted">Todavía no tiene foto.</p>
        }

        <form asp-action="CambiarFoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Foto" class="form-label"></label>
                <input asp-for="Foto" type="file" class="form-control" accept="image/jpeg,image/png" />
                <div class="form-text">JPG o PNG, máximo 5 MB.</div>
                <span asp-validation-for="Foto" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar foto</button>
                <a asp-action="Index" class="btn btn-link">Cancelar</a>
            </div>
        </form>
    </div>
</div>
