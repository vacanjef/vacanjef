@using VacanJef.Core.Enums
@using VacanJef.Web.Models.GestionReservas
@using VacanJef.Web.Models.Reservas
@model GestionReservasViewModel
@{
    ViewData["Title"] = "Gestión de reservas";
}

<h1 class="h3 mb-3">Gestión de reservas</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="mb-4">
    <h2 class="h5">Ocupación de los próximos 14 días</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var dia in Model.Ocupacion)
        {
            <div class="border rounded text-center px-2 py-1 small">
                <div class="text-muted">@PresentacionGestionReservas.DiaCorto(dia.Fecha) @dia.Fecha.ToString("dd/MM")</div>
                <span class="badge @PresentacionGestionReservas.ClaseOcupacion(dia)">@dia.Ocupados / @dia.Capacidad</span>
            </div>
        }
    </div>
</section>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-lg-3">
        <label for="Texto" class="form-label small">Mascota, dueño o correo</label>
        <input id="Texto" name="Texto" value="@Model.Filtro.Texto" maxlength="100" class="form-control" />
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="Estado" class="form-label small">Estado</label>
        <select id="Estado" name="Estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var estado in Enum.GetValues<EstadoReserva>())
            {
                <option value="@estado" selected="@(Model.Filtro.Estado == estado)">@estado</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="Desde" class="form-label small">Desde</label>
        <input id="Desde" name="Desde" type="date" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-lg-2">
        <label for="Hasta" class="form-label small">Hasta</label>
        <input id="Hasta" name="Hasta" type="date" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-lg-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (Model.Reservas.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded">No hay reservas con esos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Mascota</th>
                    <th>Dueño</th>
                    <th>Fechas</th>
                    <th>Servicio</th>
                    <th class="text-end">Costo</th>
                    <th>Estado</th>
                    <th><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reservas)
                {
                    <tr>
                        <td class="text-muted">@r.Id</td>
                        <td class="fw-semibold">@r.Mascota</td>
                        <td>@r.Dueno<br /><span class="small text-muted">@r.Correo</span></td>
                        <td>@PresentacionReservas.Fecha(r.FechaIngreso) al @PresentacionReservas.Fecha(r.FechaSalida)</td>
                        <td>@PresentacionGestionReservas.Servicio(r.Servicio)</td>
                        <td class="text-end">@PresentacionReservas.Pesos(r.CostoTotal)</td>
                        <td><span class="badge @PresentacionReservas.ClaseEstado(r.Estado)">@r.Estado</span></td>
                        <td class="text-end">
                            @if (r.SePuedeCancelar)
                            {
                                <a asp-action="Cancelar" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Cancelar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.HayMas)
    {
        <p class="small text-muted">Se muestran las primeras 200 reservas. Use los filtros para acotar.</p>
    }
}
