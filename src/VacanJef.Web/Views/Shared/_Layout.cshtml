@using VacanJef.Web.Navegacion
@inject IWebHostEnvironment Entorno
@{
    var menu = MenuNavegacion.Para(User);
    var rutaActual = Context.Request.Path.Value;
    var ambiente = IndicadorAmbiente.Etiqueta(Entorno);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B6E7F" />
    <title>@ViewData["Title"] · VacanJef</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/vacanjef.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VacanJef.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="vj-saltar visually-hidden-focusable" href="#contenido">Saltar al contenido</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-vj" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">VacanJef</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        @foreach (var elemento in menu)
                        {
                            var activo = MenuNavegacion.EstaActivo(elemento, rutaActual);
                            <li class="nav-item">
                                <a class="nav-link @(activo ? "active" : "")" href="@elemento.Ruta"
                                   aria-current="@(activo ? "page" : null)">@elemento.Texto</a>
                            </li>
                        }
                    </ul>

                    <partial name="_MenuSesion" />
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="vj-pie py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 small">
            <span>&copy; @DateTime.Now.Year VacanJef · Guardería canina @if (ambiente is not null) { <span class="badge text-bg-warning ms-2">Ambiente: @ambiente</span> }</span>
            <a asp-controller="Home" asp-action="Privacy">Privacidad y tratamiento de datos</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
