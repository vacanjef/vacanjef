@* Enlaces de sesión en la barra superior (HU-001, HU-002) *@
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="navbar-text text-dark me-3">@User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-dark">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
        </li>
    }
</ul>
