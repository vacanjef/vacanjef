@model VacanJef.Web.Models.Auditoria.AuditoriaIndexViewModel
@using VacanJef.Web.Servicios
@{
    ViewData["Title"] = "Auditoría";
}

<h1 class="h3 vj-titulo-pagina mb-3">Auditoría</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="vj-tarjeta mb-4" aria-labelledby="titulo-supresion">
    <h2 id="titulo-supresion" class="h5 mb-2">Solicitudes de supresión de datos pendientes</h2>
    <p class="small vj-texto-suave">
        Ley 1581 de 2012: se responden en máximo 15 días hábiles. La fecha límite no descuenta festivos.
        Para suprimir los datos, desactive la cuenta en <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
        y conserve solo lo que exija una obligación legal; luego marque la solicitud como atendida.
    </p>

    @if (Model.Pendientes.Count == 0)
    {
        <p class="vj-texto-suave mb-0">No hay solicitudes pendientes.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Titular</th>
                        <th>Correo</th>
                        <th>Solicitada</th>
                        <th>Fecha límite</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model.Pendientes)
                    {
                        var vencida = solicitud.FechaLimite < DateTime.UtcNow;
                        <tr>
                            <td>@solicitud.Nombre</td>
                            <td>@solicitud.Correo</td>
                            <td>@solicitud.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                @solicitud.FechaLimite.ToLocalTime().ToString("dd/MM/yyyy")
                                @if (vencida)
                                {
                                    <span class="badge text-bg-danger ms-1">Vencida</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="AtenderSupresion" method="post">
                                    <input type="hidden" name="usuarioId" value="@solicitud.UsuarioId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Marcar como atendida</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<form asp-action="Index" method="get" class="vj-tarjeta row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label for="accion" class="form-label">Acción</label>
        <select id="accion" name="accion" class="form-select">
            <option value="">Todas</option>
            @foreach (var accion in ConsultaAuditoria.AccionesConocidas)
            {
                if (Model.Filtro.Accion == accion.Key)
                {
                    <option value="@accion.Key" selected>@accion.Value</option>
                }
                else
                {
                    <option value="@accion.Key">@accion.Value</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="desde" class="form-label">Desde</label>
        <input id="desde" name="desde" type="date" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="hasta" class="form-label">Hasta</label>
        <input id="hasta" name="hasta" type="date" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="texto" class="form-label">Usuario o recurso</label>
        <input id="texto" name="texto" value="@Model.Filtro.Texto" class="form-control" placeholder="Nombre, correo o Usuario #12" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-grow-1">Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<p class="small vj-texto-suave">Se muestran los @ConsultaAuditoria.MaximoRegistros registros más recientes que cumplen el filtro.</p>

@if (Model.Registros.Count == 0)
{
    <div class="text-center vj-texto-suave py-5 border rounded">No hay registros con esos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Quién</th>
                    <th>Acción</th>
                    <th>Recurso</th>
                    <th>Resultado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registro in Model.Registros)
                {
                    <tr>
                        <td class="text-nowrap">@registro.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@registro.Autor</td>
                        <td>@registro.Descripcion</td>
                        <td>@registro.Recurso</td>
                        <td>
                            @if (registro.Resultado == "denegado")
                            {
                                <span class="badge text-bg-danger">denegado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">@registro.Resultado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
