@model IEnumerable<VacanJef.Web.Servicios.CamaraResumen>
@{
    ViewData["Title"] = "Cámaras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 vj-titulo-pagina mb-0">Cámaras</h1>
    <a asp-action="Crear" class="btn btn-primary">Registrar cámara</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p class="small vj-texto-suave">
    Las cámaras se asignan a las mascotas en <a asp-controller="Estadias" asp-action="Index">Estadías</a>.
    Por seguridad, la dirección del video no se muestra.
</p>

@if (!Model.Any())
{
    <div class="text-center vj-texto-suave py-5 border rounded">
        <p class="mb-3">Todavía no hay cámaras registradas.</p>
        <a asp-action="Crear" class="btn btn-outline-primary">Registrar la primera</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>En uso por</th>
                    <th><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nombre</td>
                        <td>
                            @if (c.Activa)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Desactivada</span>
                            }
                        </td>
                        <td>@(c.MascotaActual ?? "Libre")</td>
                        <td class="text-end">
                            <form asp-action="CambiarEstado" asp-route-id="@c.Id" method="post" class="d-inline">
                                <input type="hidden" name="activa" value="@(c.Activa ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm @(c.Activa ? "btn-outline-danger" : "btn-outline-success")">
                                    @(c.Activa ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
