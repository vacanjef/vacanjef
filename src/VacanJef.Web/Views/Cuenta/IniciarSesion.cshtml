@model VacanJef.Web.Models.Cuenta.IniciarSesionViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-2">Iniciar sesión</h1>
        <p class="text-muted mb-4">Ingrese con el correo y la contraseña de su cuenta.</p>

        <form asp-action="IniciarSesion" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Recordarme" class="form-check-input" />
                <label asp-for="Recordarme" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
        </form>

        <p class="mt-4 text-center">
            ¿No tiene cuenta? <a asp-action="Registro">Cree una aquí</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
