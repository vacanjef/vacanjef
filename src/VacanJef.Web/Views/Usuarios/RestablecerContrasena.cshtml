@model VacanJef.Web.Models.Contrasena.RestablecerContrasenaViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 vj-titulo-pagina mb-2">Restablecer contraseña</h1>
        <p class="vj-texto-suave mb-4">
            Asigne una contraseña temporal a <strong>@Model.Nombre</strong>. Deberá cambiarla la próxima vez que
            inicie sesión. Entréguela por un medio seguro.
        </p>

        <form asp-action="RestablecerContrasena" asp-route-id="@Model.Id" method="post" novalidate class="vj-tarjeta">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="Nombre" />

            <div class="mb-3">
                <label asp-for="NuevaContrasena" class="form-label"></label>
                <input asp-for="NuevaContrasena" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Restablecer</button>
                <a asp-action="Index" class="btn btn-link">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
