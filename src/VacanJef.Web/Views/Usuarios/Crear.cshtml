@model VacanJef.Web.Models.Usuarios.NuevoUsuarioViewModel
@using VacanJef.Web.Servicios
@{
    ViewData["Title"] = "Crear cuenta de personal";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 vj-titulo-pagina mb-2">Crear cuenta de personal</h1>
        <p class="vj-texto-suave mb-4">
            Para cuidadores y administradores. Los dueños crean su propia cuenta desde el registro público.
        </p>

        <form asp-action="Crear" method="post" novalidate class="vj-tarjeta">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="off" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" autocomplete="off" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    @foreach (var rol in GestionUsuarios.RolesCreables)
                    {
                        <option value="@rol">@GestionUsuarios.NombreRol(rol)</option>
                    }
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                <div class="form-text">
                    Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.
                    Entréguela a la persona por un medio seguro.
                </div>
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Crear cuenta</button>
                <a asp-action="Index" class="btn btn-link">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
